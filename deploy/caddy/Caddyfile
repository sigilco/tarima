# Port 80 plain HTTP reverse proxy to tarima Node process
:80 {
	reverse_proxy 127.0.0.1:3001
}

# IP-based HTTPS with internal self-signed cert
https://37.187.62.157, https://100.105.198.36 {
	tls internal
	encode zstd gzip
	reverse_proxy 127.0.0.1:3001
}

