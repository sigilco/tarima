# Litestream R2 replication credentials.
# Real values live in /opt/tarima/shared/litestream.env on the VPS (rendered
# from Infisical, never in the repo). Create a dedicated R2 token with
# read+write on the tarima-backups bucket.
S3_ACCESS_KEY=<r2-access-key-id>
S3_SECRET_KEY=<r2-secret-access-key>
