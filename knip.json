{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "ignoreDependencies": [
        "@iconify/json",
        "oxlint",
        "oxfmt",
        "@logtape/file",
        "@logtape/logtape",
        "valibot",
        "vitest",
        "nanostores"
      ]
    },
    "apps/*": {
      "entry": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/paraglide/**"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/*.ts"]
    },
    "apps/web": {
      "entry": ["src/**/*.{ts,tsx}", "vite.cosmos.config.ts", "cosmos.imports.ts"],
      "ignore": ["src/paraglide/**", "public/_worker.js"],
      "ignoreUnresolved": ["../paraglide/messages.js"],
      "ignoreDependencies": ["@nanostores/react", "cloudflare", "shadcn"],
      "ignoreBinaries": ["tsgo"]
    },
    "apps/api": {
      "ignoreDependencies": ["grammy", "node-html-parser", "postal-mime"]
    },
    "apps/inbound-worker": {
      "entry": ["src/**/*.ts"]
    },
    "packages/engine": {
      "entry": ["src/journal.ts", "src/runner.ts", "src/db.ts", "src/schema.ts", "src/types.ts"]
    },
    "packages/chase": {
      "entry": ["src/sfm.ts", "src/template.ts", "src/handlers.ts", "src/llm.ts", "src/register.ts"]
    },
    "tests/e2e": {
      "entry": ["src/api/helpers/*.ts", "src/api/**/*.test.ts", "ui/**/*.ts"],
      "ignoreDependencies": ["@playwright/test"]
    },
    "packages/eve": {
      "entry": ["bin/eve.js"],
      "ignore": ["bin/eve.d.ts"],
      "ignoreDependencies": ["nitro", "rolldown", "undici"]
    }
  },
  "ignore": [
    "apps/api/src/db/index.test.ts",
    "apps/api/src/server.ts",
    "apps/web/tests/turn/agent-turn.mjs",
    "apps/web/tests/turn/turn-seed-venues.mjs"
  ],
  "ignoreBinaries": ["validate"],
  "ignoreDependencies": [
    "@tanstack/react-router",
    "@tanstack/react-start",
    "react",
    "react-cosmos-core",
    "react-dom"
  ]
}
