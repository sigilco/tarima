{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "ignoreDependencies": [
        "@iconify/json",
        "oxlint",
        "oxfmt",
        "@logtape/file",
        "@logtape/logtape",
        "nanostores"
      ]
    },
    "apps/*": {
      "entry": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/paraglide/**"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/*.ts"]
    },
    "apps/web": {
      "entry": ["src/**/*.{ts,tsx}", "vite.cosmos.config.ts"],
      "ignore": ["public/_worker.js"],
      "ignoreDependencies": ["shadcn"]
    },
    "apps/api": {},
    "apps/inbound-worker": {
      "entry": ["src/**/*.ts"]
    },
    "packages/eve": {
      "entry": [],
      "ignore": ["bin/eve.d.ts", "dist/**"],
      "ignoreDependencies": ["nitro"]
    }
  },
  "ignore": [
    "apps/web/tests/turn/agent-turn.mjs",
    "apps/web/tests/turn/turn-seed-venues.mjs",
    "apps/web/tests/chat/chat-turn.mjs",
    "apps/web/tests/chat/approval-turn.mjs",
    "apps/web/tests/chat/approval-seed-sponsor.mjs",
    "apps/web/tests/turn/telegram-e2e.mjs"
  ],
  "ignoreDependencies": [
    "@tanstack/react-router",
    "@tanstack/react-start",
    "react",
    "react-cosmos-core",
    "react-dom"
  ]
}
