# Copy to .env.local (gitignored); `mise run setup` does this when missing.
# These are safe local-only defaults; production values never live here.
# `mise run doctor` reports which of these are set (never their values).

# --- core ---
# SQLite database (relative to the repo root; apps/api resolves it there).
DATABASE_URL=.data/dev.db
# Session cookie signing secret. The dev default is insecure — set a real
# one anywhere this is not a throwaway local DB.
# SESSION_SECRET=...
# Comma-separated emails allowed to request logins; empty/unset = open.
# Set this to lock the instance down to specific people.
# BETA_ALLOWLIST=you@example.com
# Attachment storage root for channel media (default ./data).
# DATA_DIR=./data

# --- web dev server (scripts/dev.ts) ---
# Port vite dev / the preview server binds.
WEB_PORT=3000
# Port override for the built server itself (scripts/dev.ts --preview sets
# PORT from WEB_PORT; apps/api standalone defaults to 3001).
# PORT=3000
# API origin the browser bundle calls (defaults to the dev server itself).
# VITE_API_ORIGIN=http://localhost:3000
# Public origin used for SEO/canonical URLs (defaults to the page origin).
# VITE_SITE_ORIGIN=http://localhost:3000

# --- agent runtime (eve, in-process) ---
# Port the in-process eve runtime binds (loopback).
TARIMA_EVE_PORT=4310
# Point the web app at an eve runtime serving elsewhere instead of
# mounting one in-process (advanced; leave unset normally).
# TARIMA_EVE_ORIGIN=http://127.0.0.1:4310
# Set to 0 to skip the on-demand `eve build` when .output/ is missing.
# TARIMA_EVE_BUILD=0
# LLM gateway. Without these, scripts/dev.ts falls back to the
# deterministic stub LLM (fine for UI/mocks work; not real replies).
# It also tries the macOS Keychain item "bifrost" before stubbing.
# BIFROST_VK=...
# BIFROST_BASE_URL=http://127.0.0.1:8317/v1
# Gateway model id (default zai-coding-plan/glm-5).
# TARIMA_AGENT_MODEL=zai-coding-plan/glm-5
# Declared context window for the model above (default 131072).
# TARIMA_AGENT_CONTEXT_TOKENS=131072
# Per-turn timeout for agent replies in ms (default 180000).
# TARIMA_AGENT_TURN_TIMEOUT_MS=180000
# Force the deterministic stub LLM even when BIFROST_VK exists (tests).
# TARIMA_AGENT_STUB=1

# --- channels ---
# Dev-only instant login: GET /api/dev/login?email=you@tarima.test
# (disabled when NODE_ENV=production or DEV_LOGIN=0)
DEV_LOGIN=1
# Loopback-only mail domain: mail to it never leaves the machine, it is
# captured in the loopback_inbox table instead.
EMAIL_LOOPBACK_DOMAINS=tarima.test
# Sender address for outbound mail (default notifications@tarima.illo.fyi).
# MAIL_FROM=...
# Brevo HTTP API key for real outbound mail. Without it, non-loopback
# mail is logged to stdout only (no-op).
# BREVO_API_KEY=...
# Shared secret for the inbound email webhook (POST /webhooks/email).
# Required for real inbound mail; unset = webhook rejects.
# INBOUND_WEBHOOK_SECRET=...

# Channel mocks (scripts/dev.ts boots them on these ports).
TELEGRAM_API_BASE_URL=http://127.0.0.1:3511
WHATSAPP_API_BASE_URL=http://127.0.0.1:3512
MAIL_API_BASE_URL=http://127.0.0.1:3513
# Mock listen-port overrides (defaults 3511/3512/3513).
# TELEGRAM_PORT=3511
# WHATSAPP_PORT=3512
# MAIL_PORT=3513

# Outreach identity (agent-sent mail; defaults are fine for dev).
# MAIL_FROM_OUTREACH=outreach@outreach.tarima.events
# OUTREACH_REPLY_DOMAIN=outreach.tarima.events
# OUTREACH_POSTAL_ADDRESS="Tarima, Street 1, 28001 Madrid"
# Display name on outreach mail (default "Tarima venue outreach").
# OUTREACH_IDENTITY=Tarima venue outreach

# Telegram channel (live). TELEGRAM_API_BASE_URL above doubles as the Bot
# API base for the agent channel via TARIMA_TELEGRAM_API_BASE_URL — set
# the TARIMA_ name only when it must differ from the mock seam.
# TELEGRAM_BOT_TOKEN=...                  # from @BotFather
# TELEGRAM_WEBHOOK_SECRET_TOKEN=...       # header check on inbound updates
# TARIMA_TELEGRAM_API_BASE_URL=http://127.0.0.1:3511


# WhatsApp Cloud API channel (live; agent side, Chat SDK adapter).
# WHATSAPP_ACCESS_TOKEN=...               # permanent/system-user token
# WHATSAPP_APP_SECRET=...                 # app secret for signature checks
# WHATSAPP_PHONE_NUMBER_ID=...            # the sender phone number id
# WHATSAPP_VERIFY_TOKEN=...               # webhook verify handshake token
# WHATSAPP_BOT_USERNAME=tarima            # display name
# WHATSAPP_API_URL=...                    # adapter's own Graph API override
#   (WHATSAPP_API_BASE_URL above is the repo seam and maps onto it)

# WhatsApp outbound provider used by the api notification path
# (@tarima/channels). Same Meta app, different token shape.
# WHATSAPP_TOKEN=...
# WHATSAPP_PHONE_NUMBER_ID=...
# WHATSAPP_APP_SECRET=...
# WHATSAPP_VERIFY_TOKEN=...

# --- search / enrichment providers (all optional, safe by default) ---
# Local cauce fetch-and-index pipeline used by sponsor search and the
# tier-2 venue enrichment ladder (POST {CAUCE_BASE_URL}/api/search and
# /api/pages). Defaults to http://127.0.0.1:4479 when unset.
# CAUCE_BASE_URL=http://127.0.0.1:4479
# Page fetches per enrichment run (default 30).
# TARIMA_CRAWL_BUDGET_PER_RUN=30
# LLM fallback spend cap for extraction, cents/day (default 100).
# TARIMA_LLM_EXTRACT_DAILY_CENTS=100
# Model for the extraction fallback (default zai-coding-plan/glm-5).
# TARIMA_LLM_EXTRACT_MODEL=zai-coding-plan/glm-5
# Tier-3 LLM extraction is OFF unless explicitly enabled (default 0);
# proposed values are still verified verbatim against the fetched page.
# TARIMA_LLM_EXTRACT_ENABLED=0
# Uses the same BIFROST_VK/BIFROST_BASE_URL as the agent.

# Google Places API (New) escalation tier. Master switch ships OFF; even
# enabled, Enterprise masks (phone/website/hours) need FIELD_TIER and
# stay under the daily caps below. The key rides the X-Goog-Api-Key
# header only and only place_id is ever persisted.
# GOOGLE_MAPS_API_KEY=...
# GOOGLE_PLACES_ENABLED=0
# GOOGLE_PLACES_FIELD_TIER=pro        # pro | enterprise
# GOOGLE_PLACES_DAILY_BUDGET=10       # live calls/day (app-side; Cloud quota is the outer belt)
# GOOGLE_PLACES_ENTERPRISE_DAILY=10   # of those, how many may use Enterprise masks
# GOOGLE_PLACES_WARM_DAILY=0          # cache-warming cap; 0 = warming never spends Google calls

# Foursquare Places details for shortlisted venues (FSQ_API_KEY).
# FSQ_API_KEY=...
# FSQ_PLACES_DAILY_BUDGET=16          # live calls/day app-side cap

# --- search-core batch ---
# Geoapify Places (free plan, no card). Read from env only; never commit a key.
# Required for live place search; tests inject fixtures and do not need this.
# GEOAPIFY_API_KEY=

# Overpass public daily query budget (default 100). Used by the hedge arm.
# TARIMA_PLACE_OVERPASS_BUDGET=100

# Cache-warming job (off by default). Set to 1 to seed a grid of areas.
# TARIMA_PLACE_CACHE_WARM=0

# Shortlist size for the tier-2 enrich pass inside search_venues
# (FSQ details + cauce crawl), default 5, 0 disables enrichment.
# TARIMA_PLACE_ENRICH_TOP_K=5


# --- observability ---
# LogTape sinks: LOG_SINK=console|jsonl|both (default console),
# LOG_LEVEL=error|warning|info|debug|trace (default info),
# LOG_FILE=path for the jsonl sink (default .logs/tarima.jsonl).
# LOG_SINK=console
# LOG_LEVEL=info
# LOG_FILE=.logs/tarima.jsonl

# --- local test / harness knobs (optional; the suites set their own) ---
# Playwright e2e base URL (default http://localhost:3100).
# E2E_BASE_URL=http://localhost:3100
# Smoke-gate port override (default 3900).
# SMOKE_PORT=3900
# Telegram turn-test fake Bot API port / tmp dir (telegram-e2e.mjs).
# TG_FAKE_PORT=3410
# TG_E2E_TMP=/tmp/tg-e2e
# WhatsApp round-trip mock port (whatsapp-roundtrip.mjs).
# WA_MOCK_PORT=3522
# Throwaway DB + app secret for the whatsapp round-trip harness.
# APP_DB=/tmp/wa-roundtrip.db
# APP_SECRET=...
# Smoke-gate internals (verify:smoke / smoke-leak-check only; the suites
# set their own).
# SMOKE_DEADLINE_MS=55000        # overall smoke deadline
# SMOKE_FORCE_FAIL=1             # make one check fail (leak-check uses this)
# SMOKE_REPORT_CHILDREN=1        # print spawned child pids for the leak check

