    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tarima/api": "workspace:*",
    "@tarima/api-keys": "workspace:*",
    "@tarima/auth-core": "workspace:*",
    "@tarima/contract": "workspace:*",
    "@tarima/obs": "workspace:*",
    "@tarima/venuesearch": "workspace:*",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "nanostores": "^1.5.5",
    "nitro": "^3.0.260311-beta",
