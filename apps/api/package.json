{
  "name": "@tarima/api",
  "private": true,
  "type": "module",
  "exports": {
    "./db/schema": "./src/db/schema.ts",
    "./db": "./src/db/index.ts",
    "./server": "./src/server.ts",
    "./routes/*": "./src/routes/*.ts",
    "./middleware/*": "./src/middleware/*.ts",
    "./services/*": "./src/services/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./mail": "./src/mail.ts",
    "./channels": "./src/channels.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "seed-venues": "tsx scripts/seed-venues.ts",
    "build": "node ./scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@logtape/file": "catalog:",
    "@logtape/logtape": "catalog:",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tarima/auth-core": "workspace:*",
    "@tarima/channels": "workspace:*",
    "@tarima/contract": "workspace:*",
    "@tarima/obs": "workspace:*",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
