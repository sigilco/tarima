{
  "compilerOptions": {
    "target": "ES2022",
    // ES2023 for the immutable array helpers (toSorted, toReversed) used
    // by the workspace packages; the runtime is node 22, so they exist.
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "scripts", "drizzle.config.ts"]
}
